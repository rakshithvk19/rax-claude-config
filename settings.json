      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git describe*)",
      "Bash(git remote -v*)",
      "Bash(git check-ignore*)",
