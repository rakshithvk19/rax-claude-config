      "Bash(which *)",
      "Bash(whereis *)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(uname*)",
      "Bash(date*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.password-store/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.config/BraveSoftware/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.config/solana/**)",
      "Read(~/.ethereum/**)",
      "Read(~/.bitcoin/**)",
      "Read(~/.electrum/**)",
      "Read(~/.config/Exodus/**)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(.env.*.local)",
      "Edit(**/.env.*.local)",
      "Edit(.env.production)",
      "Edit(**/.env.production)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.production)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(env | base64*)",
      "Bash(printenv | base64*)",
      "Bash(find / -name id_rsa*)",
      "Bash(find / -name *.key*)",
      "Bash(find / -name *.pem*)",
      "Bash(*wallet.dat*)",
      "Bash(*privatekey*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm --recursive --force *)",
      "Bash(rm --force --recursive *)",
      "Bash(sudo *)",
      "Bash(pkexec *)",
      "Bash(mkfs*)",
      "Bash(dd *)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Bash(> /dev/sd*)",
      "Bash(> /dev/nvme*)",
      "Bash(cat /dev/urandom > *)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(wget *|sh*)",
      "Bash(wget *| sh*)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(* | base64 -d | sh*)",
      "Bash(* | base64 -d | bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--mirror*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(poweroff*)",
      "Bash(init 0*)",
      "Bash(init 6*)",
      "Bash(bash -i >& /dev/tcp/*)",
      "Bash(sh -i >& /dev/tcp/*)",
      "Bash(exec < /dev/tcp/*)",
      "Bash(exec > /dev/tcp/*)",
      "Bash(exec 3<>/dev/tcp/*)",
      "Bash(nc -l*)",
      "Bash(netcat -l*)",
      "Bash(* | nc -l*)",
      "Bash(* | netcat -l*)",
      "Bash(socat*)",
      "Bash(* | socat *)",
      "Bash(nmap*)",
      "Bash(masscan*)",
      "Bash(python -c 'import socket*)",
      "Bash(python3 -c 'import socket*)",
      "Bash(perl -e 'use Socket*)",
      "Bash(ruby -rsocket*)",
      "Bash(php -r '$sock*)",
      "Bash(docker run --privileged *)",
      "Bash(docker run --pid=host *)",
      "Bash(docker run --net=host *)",
      "Bash(docker run --cap-add=ALL *)",
      "Bash(docker run -v /:/host *)",
      "Bash(docker run -v /var/run/docker.sock:/var/run/docker.sock *)",
      "Bash(podman run --privileged *)",
      "Bash(podman run --pid=host *)",
      "Bash(podman run --net=host *)",
      "Bash(podman run --cap-add=ALL *)",
      "Bash(podman run -v /:/host *)",
      "Bash(nsenter *)",
      "Bash(passwd*)",
      "Bash(chmod -R 777 /*)",
      "Bash(chmod --recursive 777 /*)",
      "Bash(chown -R * /*)",
      "Bash(chown --recursive * /*)",
      "Bash(find / -type f -delete*)",
      "Bash(find / -type d -delete*)",
      "Bash(rm /var/log/*)",
      "Bash(truncate -s 0 /var/log/*)",
      "Bash(insmod *)",
      "Bash(rmmod *)",
      "Bash(modprobe *)",
      "Bash(sysctl -w *)",
      "Bash(gdb -p *)",
      "Bash(LD_PRELOAD=*)",
      "Bash(export PATH=*)",
      "Bash(export LD_LIBRARY_PATH=*)",
      "Bash(systemctl mask *)",
      "Bash(systemctl disable *)",
      "Bash(curl http://169.254.169.254/*)",
      "Bash(wget http://169.254.169.254/*)",
      "Bash(curl http://metadata.google.internal/*)",
      "Bash(npm install -g * --unsafe-perm*)",
      "Bash(pip install * --break-system-packages*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq --raw-output '.tool_input.command' |\n  grep --quiet --extended-regexp '(^|[;&|[:space:]])git([[:space:]]+-[cC][[:space:]]+[^[:space:]]+)*[[:space:]]+(add|commit|push|pull|fetch|switch|checkout|restore|reset|rebase|merge|cherry-pick|revert|stash|rm|mv|tag|branch|clean|apply|am)([[:space:]]|$)' &&\n  { echo 'Never run a git command that writes. Hand the command to the user instead. For the current branch name, use git rev-parse --abbrev-ref HEAD' >&2; exit 2; } ||\n  exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq --compact-output 'if .agent_id then {hookSpecificOutput: {hookEventName: \"PermissionRequest\", decision: {behavior: \"deny\", message: \"Subagents run unattended and cannot request approval. Do not retry this call or look for another route to the same action. Record the exact command or tool call under Needs decision in your report, and carry on with the work that needs no approval.\"}}} else empty end'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "test -f \"$CLAUDE_PROJECT_DIR/graphify-out/graph.json\" || exit 0\ncd \"$CLAUDE_PROJECT_DIR\" &&\n  graphify update . > /dev/null 2>&1 &&\n  echo '{\"systemMessage\": \"Code graph updated\"}' ||\n  echo '{\"systemMessage\": \"Code graph update failed: run graphify update . to see why\"}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
